//@version=5
// =============================================================================
//  MTF Scalping Suite v2 — EMA9 Cross + Bias + EMA100 + OB(Sweep) + FVG + Volume Profile + TP/SL
//  ผู้ใช้: เทรดเดอร์ (กรอบ ICT + Volume Profile "Edge Rotation" + EMA momentum)
//  ใส่บนชาร์ตไหนก็ได้ (แนะนำ M1/M5) — สัญญาณ MTF ดึงผ่าน request.security
//
//  อัปเดตจาก v1:
//   • โหมดเข้า: เลือกได้ระหว่าง "EMA9 ตัด EMA(สัญญาณ)"  หรือ  "ราคา ตัด EMA9"
//   • Order Block (M5 + M15): บังคับให้มี Liquidity Sweep ก่อน displacement ได้ (ตาม Edge Rotation)
//   • Volume Profile (M5 + M15) วาดคู่กันทางขวา | หน่วย $ (volume × ราคา) | โหมด TOTAL หรือ DELTA (Buy-Sell)
//   • Label "$xxxK / $x.xM" บนเส้น POC ทั้ง M5 และ M15
//   • TP/SL อัตโนมัติ: SL ใต้/เหนือจุดสวีป-สวิง หรือ ATR | TP แบบ R:R หรือ POC/Value Area (M15)
//   • ตารางจัด layout 4 มุม + ปรับขนาดตัวอักษรได้ (เหมาะกับมือถือ)
//
//  หมายเหตุ: เครื่องมือช่วยตัดสินใจ ไม่ใช่คำแนะนำการลงทุน — ทดสอบย้อนหลังก่อนใช้จริงเสมอ
// =============================================================================
indicator("MTF EMA9 Cross + OB(Sweep) + FVG + VP + TP/SL [v2]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ----------------------------------------------------------------------------
//  INPUTS
// ----------------------------------------------------------------------------
grpTF   = "ไทม์เฟรม (Timeframes)"
tfM1    = input.timeframe("1",  "TF สัญญาณ #1 (M1)", group=grpTF)
tfM3    = input.timeframe("3",  "TF สัญญาณ #2 (M3)", group=grpTF)
tfM5    = input.timeframe("5",  "TF สัญญาณ #3 (M5)", group=grpTF)
tfLTF   = input.timeframe("15", "LTF Bias / OB / VP (M15)", group=grpTF)
tfHTF   = input.timeframe("30", "HTF Bias (M30)",    group=grpTF)

grpEMA  = "EMA & โหมดเข้า"
entryMode = input.string("EMA9_CROSS_EMA", "โหมดสัญญาณเข้า", options=["EMA9_CROSS_EMA", "PRICE_CROSS_EMA9"], tooltip="EMA9_CROSS_EMA = EMA9 ตัด EMA สัญญาณ | PRICE_CROSS_EMA9 = ราคา ตัด EMA9", group=grpEMA)
lenFast = input.int(9,   "EMA เร็ว (Momentum)",  minval=1, group=grpEMA)
lenSig  = input.int(21,  "EMA สัญญาณ (ตัวที่ EMA9 ตัด)", minval=1, group=grpEMA)
lenTrend= input.int(100, "EMA เทรนด์ (Trend Line)", minval=1, group=grpEMA)
showSig = input.bool(true, "แสดงลูกศร Buy/Sell บนชาร์ต", group=grpEMA)

grpOB   = "Order Block (M5 + M15) + Sweep"
showOBM15 = input.bool(true, "แสดง OB ที่ M15", group=grpOB)
showOBM5  = input.bool(true, "แสดง OB ที่ M5",  group=grpOB)
obReqSweep = input.bool(true, "บังคับมี Liquidity Sweep ก่อน (Edge Rotation)", group=grpOB)
obSwLB  = input.int(10, "ช่วงหาสภาพคล่อง/สวิงสำหรับ Sweep", minval=3, group=grpOB)
obMax   = input.int(4, "จำนวน OB ที่เก็บ (ต่อฝั่ง / ต่อ TF)", minval=1, maxval=10, group=grpOB)
obDispx = input.float(1.0, "ตัวคูณ Displacement (เท่าของ ATR)", step=0.1, group=grpOB)
colOBbull   = input.color(color.new(color.teal,   80), "สี OB M15 ฝั่งซื้อ", group=grpOB)
colOBbear   = input.color(color.new(color.red,    80), "สี OB M15 ฝั่งขาย", group=grpOB)
colOBbullM5 = input.color(color.new(color.aqua,    78), "สี OB M5 ฝั่งซื้อ", group=grpOB)
colOBbearM5 = input.color(color.new(color.fuchsia, 78), "สี OB M5 ฝั่งขาย", group=grpOB)

grpFVG  = "Fair Value Gap (M5)"
showFVG = input.bool(true, "แสดง FVG ที่ M5", group=grpFVG)
fvgMax  = input.int(6, "จำนวน FVG ที่เก็บ (ต่อฝั่ง)", minval=1, maxval=15, group=grpFVG)
colFVGbull = input.color(color.new(color.green, 82), "สี FVG ฝั่งซื้อ", group=grpFVG)
colFVGbear = input.color(color.new(color.maroon,82), "สี FVG ฝั่งขาย", group=grpFVG)

grpVP   = "Volume Profile (M5 + M15 Fixed Range)"
showVPM15 = input.bool(true,  "แสดง Volume Profile M15", group=grpVP)
showVPM5  = input.bool(true,  "แสดง Volume Profile M5",  group=grpVP)
vpDollar  = input.bool(true,  "หน่วย Volume เป็นดอลลาร์ ($)", tooltip="เปิด = ใช้ volume × ราคา (hl2) ให้หน่วยเป็น $ (ปริมาณเงิน) | ปิด = ใช้ปริมาณดิบ", group=grpVP)
vpMode    = input.string("TOTAL", "โหมด Profile", options=["TOTAL", "DELTA"], tooltip="TOTAL = Volume Profile รวม | DELTA = Buy-Sell (close>open = Buy, close<open = Sell) — POC = ระดับที่มี net pressure สูงสุด", group=grpVP)
vpBars  = input.int(80, "จำนวนแท่งที่ใช้คำนวณ (ต่อ TF)", minval=20, maxval=240, group=grpVP)
vpRows  = input.int(24, "จำนวนแถว (Rows)", minval=8, maxval=50, group=grpVP)
vpVA    = input.float(70, "Value Area %", minval=50, maxval=95, group=grpVP)
vpWidth = input.int(60, "ความกว้าง histogram ต่อ TF (แท่ง)", minval=10, maxval=150, group=grpVP)
vpOffset= input.int(8,  "ระยะห่างจากแท่งล่าสุด (แท่ง)", minval=0, maxval=50, group=grpVP)
colVP    = input.color(color.new(color.gray,    75), "สี histogram M15", group=grpVP)
colPOC   = input.color(color.orange, "สี POC M15", group=grpVP)
colVA    = input.color(color.new(color.blue,    40), "สี VAH/VAL M15", group=grpVP)
colVPM5  = input.color(color.new(color.purple,  75), "สี histogram M5", group=grpVP)
colPOCM5 = input.color(color.aqua, "สี POC M5", group=grpVP)
colVAM5  = input.color(color.new(color.fuchsia, 40), "สี VAH/VAL M5", group=grpVP)

grpTPSL = "TP / SL อัตโนมัติ"
showTPSL= input.bool(true, "แสดงเส้น TP/SL ของสัญญาณล่าสุด", group=grpTPSL)
slMode  = input.string("SWING_SWEEP", "วิธีตั้ง SL", options=["SWING_SWEEP", "ATR"], tooltip="SWING_SWEEP = ใต้/เหนือ swing+สวีป | ATR = ตาม ATR", group=grpTPSL)
slLB    = input.int(10, "ช่วงหา Swing สำหรับ SL", minval=3, group=grpTPSL)
atrLen  = input.int(14, "ATR Length", minval=1, group=grpTPSL)
slAtr   = input.float(1.5, "SL = ATR x", step=0.1, group=grpTPSL)
slBuf   = input.float(0.2, "บัฟเฟอร์ SL (เท่าของ ATR)", step=0.1, group=grpTPSL)
tpMode  = input.string("VP_POC_VA", "วิธีตั้ง TP", options=["VP_POC_VA", "RR"], tooltip="VP_POC_VA = TP ที่ POC/Value Area | RR = ตาม R:R", group=grpTPSL)
rr1     = input.float(2.0, "TP1 = R:R", step=0.1, group=grpTPSL)
rr2     = input.float(3.0, "TP2 = R:R", step=0.1, group=grpTPSL)

grpVol  = "Volume Buy/Sell"
volLen  = input.int(20, "จำนวนแท่งที่รวมปริมาณ (ต่อ TF)", minval=5, group=grpVol)

grpBO   = "Breakout M15"
boLen   = input.int(20, "ช่วงหา Swing High/Low (M15)", minval=5, group=grpBO)

grpDisp = "การแสดงผล / มือถือ (Display)"
tblSizeOpt = input.string("tiny", "ขนาดตัวอักษรตาราง", options=["tiny", "small", "normal"], tooltip="iPhone/มือถือ แนะนำ tiny เพื่อให้เห็นครบทุกตาราง", group=grpDisp)
tblSize = tblSizeOpt == "tiny" ? size.tiny : tblSizeOpt == "small" ? size.small : size.normal

// ----------------------------------------------------------------------------
//  HELPER FUNCTIONS (ทำงานในบริบทของ TF ที่ส่งเข้า request.security)
// ----------------------------------------------------------------------------
// สัญญาณ: คืน [ema9, bull, crossUp(เข้าBuy/ออกSell), crossDn(เข้าSell/ออกBuy), ราคาปิด]
f_sig() =>
    e9 = ta.ema(close, lenFast)
    eS = ta.ema(close, lenSig)
    useCross = entryMode == "EMA9_CROSS_EMA"
    bull = useCross ? e9 > eS : close > e9
    cu = useCross ? ta.crossover(e9, eS)  : ta.crossover(close, e9)
    cd = useCross ? ta.crossunder(e9, eS) : ta.crossunder(close, e9)
    [e9, bull, cu, cd, close]

// Bias: +1 ขึ้น, -1 ลง, 0 side (ราคา + EMA9 เทียบ EMA100)
f_bias() =>
    e100 = ta.ema(close, lenTrend)
    e9   = ta.ema(close, lenFast)
    b = (close > e100 and e9 > e100) ? 1 : (close < e100 and e9 < e100) ? -1 : 0
    [b, e100]

// Volume Buy/Sell สะสมตามจำนวนแท่ง
f_vol() =>
    uv = math.sum(close > open ? volume : 0.0, volLen)
    dv = math.sum(close < open ? volume : 0.0, volLen)
    [uv, dv]

// Breakout M15
f_bo() =>
    hh = ta.highest(high, boLen)[1]
    ll = ta.lowest(low,  boLen)[1]
    [close > hh, close < ll, hh, ll]

// Order Block (+ ตรวจ Sweep): บังคับให้แท่งก่อน displacement กวาดสภาพคล่องก่อน
f_ob() =>
    a = ta.atr(14)
    priorLow  = ta.lowest(low,  obSwLB)[2]   // low สวิงก่อนแท่ง OB
    priorHigh = ta.highest(high, obSwLB)[2]
    // Bullish OB: แท่งแดง[1] กวาด sellside (ต่ำกว่า low เดิม) แล้วแท่ง[0] displacement ขึ้นปิดเหนือ high[1]
    bullDisp  = close > high[1] and (close - open) > a * obDispx and close[1] < open[1]
    bullSweep = low[1] < priorLow
    bullOB = bullDisp and (not obReqSweep or bullSweep)
    // Bearish OB: แท่งเขียว[1] กวาด buyside (สูงกว่า high เดิม) แล้วแท่ง[0] displacement ลงปิดใต้ low[1]
    bearDisp  = close < low[1] and (open - close) > a * obDispx and close[1] > open[1]
    bearSweep = high[1] > priorHigh
    bearOB = bearDisp and (not obReqSweep or bearSweep)
    [bullOB, bearOB, high[1], low[1], time[1]]

// FVG (3-candle imbalance)
f_fvg() =>
    bullFvg = low > high[2]
    bearFvg = high < low[2]
    [bullFvg, bearFvg, low, high[2], low[2], high, time[1]]

// ----------------------------------------------------------------------------
//  ดึงข้อมูล MTF
// ----------------------------------------------------------------------------
[m1e9, m1bull, m1cu, m1cd, m1px] = request.security(syminfo.tickerid, tfM1, f_sig(), lookahead=barmerge.lookahead_off)
[m3e9, m3bull, m3cu, m3cd, m3px] = request.security(syminfo.tickerid, tfM3, f_sig(), lookahead=barmerge.lookahead_off)
[m5e9, m5bull, m5cu, m5cd, m5px] = request.security(syminfo.tickerid, tfM5, f_sig(), lookahead=barmerge.lookahead_off)

[htfBias, htfE100] = request.security(syminfo.tickerid, tfHTF, f_bias(), lookahead=barmerge.lookahead_off)
[ltfBias, ltfE100] = request.security(syminfo.tickerid, tfLTF, f_bias(), lookahead=barmerge.lookahead_off)

[m5uv, m5dv]   = request.security(syminfo.tickerid, tfM5,  f_vol(), lookahead=barmerge.lookahead_off)
[m15uv, m15dv] = request.security(syminfo.tickerid, tfLTF, f_vol(), lookahead=barmerge.lookahead_off)

[boBull, boBear, boHH, boLL] = request.security(syminfo.tickerid, tfLTF, f_bo(), lookahead=barmerge.lookahead_off)
[obBull, obBear, obTop, obBot, obTime] = request.security(syminfo.tickerid, tfLTF, f_ob(), lookahead=barmerge.lookahead_off)
[m5obBull, m5obBear, m5obTop, m5obBot, m5obTime] = request.security(syminfo.tickerid, tfM5, f_ob(), lookahead=barmerge.lookahead_off)
[fvgBull, fvgBear, fvgBullTop, fvgBullBot, fvgBearTop, fvgBearBot, fvgTime] = request.security(syminfo.tickerid, tfM5, f_fvg(), lookahead=barmerge.lookahead_off)

// ----------------------------------------------------------------------------
//  เส้น EMA บนชาร์ตปัจจุบัน
// ----------------------------------------------------------------------------
emaTrend = ta.ema(close, lenTrend)
emaFast  = ta.ema(close, lenFast)
emaSigL  = ta.ema(close, lenSig)
plot(emaTrend, "EMA100 Trend", color=color.new(color.yellow, 0), linewidth=2)
plot(emaFast,  "EMA9 Fast",    color=color.new(color.aqua, 0),   linewidth=1)
plot(entryMode == "EMA9_CROSS_EMA" ? emaSigL : na, "EMA Signal", color=color.new(color.fuchsia, 0), linewidth=1)

// ----------------------------------------------------------------------------
//  สัญญาณเข้า/ออก บนชาร์ตปัจจุบัน (ตามโหมดที่เลือก)
// ----------------------------------------------------------------------------
useCrossChart = entryMode == "EMA9_CROSS_EMA"
buyEntry  = useCrossChart ? ta.crossover(emaFast, emaSigL)  : ta.crossover(close, emaFast)
sellEntry = useCrossChart ? ta.crossunder(emaFast, emaSigL) : ta.crossunder(close, emaFast)

plotshape(showSig and buyEntry,  title="Buy Entry",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green,0), text="BUY",  textcolor=color.white, size=size.tiny)
plotshape(showSig and sellEntry, title="Sell Entry", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,0),   text="SELL", textcolor=color.white, size=size.tiny)
plotshape(showSig and sellEntry, title="Buy Exit",   style=shape.xcross,    location=location.abovebar, color=color.new(color.lime,0),  size=size.tiny)
plotshape(showSig and buyEntry,  title="Sell Exit",  style=shape.xcross,    location=location.belowbar, color=color.new(color.orange,0),size=size.tiny)

// ----------------------------------------------------------------------------
//  ติดตามราคา/เวลา สัญญาณล่าสุด แต่ละ TF (สำหรับตาราง)
// ----------------------------------------------------------------------------
var float m1_be=na
var float m1_bx=na
var float m1_se=na
var float m1_sx=na
if m1cu
    m1_be := m1px
    m1_sx := m1px
if m1cd
    m1_se := m1px
    m1_bx := m1px

var float m3_be=na
var float m3_bx=na
var float m3_se=na
var float m3_sx=na
if m3cu
    m3_be := m3px
    m3_sx := m3px
if m3cd
    m3_se := m3px
    m3_bx := m3px

var float m5_be=na
var float m5_bx=na
var float m5_se=na
var float m5_sx=na
if m5cu
    m5_be := m5px
    m5_sx := m5px
if m5cd
    m5_se := m5px
    m5_bx := m5px

f_px(p)  => na(p) ? "-" : str.tostring(p, format.mintick)

// Format ปริมาณ → "$xxxK / $x.xM / $x.xxB" ตามขนาด (เปลี่ยน prefix ตาม vpDollar)
f_fmtVol(x) =>
    a = math.abs(x)
    sign = x < 0 ? "-" : ""
    body = a >= 1e9 ? str.tostring(a/1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(a/1e6, "#.##") + "M" : a >= 1e3 ? str.tostring(a/1e3, "#.#") + "K" : str.tostring(a, "#.#")
    (vpDollar ? "$" : "") + sign + body

// ----------------------------------------------------------------------------
//  วาด ORDER BLOCK (M15 + M5)
// ----------------------------------------------------------------------------
var box[] obBullBoxes = array.new_box()
var box[] obBearBoxes = array.new_box()
var int   lastObBullT = na
var int   lastObBearT = na

var box[] m5ObBullBoxes = array.new_box()
var box[] m5ObBearBoxes = array.new_box()
var int   lastM5ObBullT = na
var int   lastM5ObBearT = na

f_trimBox(arr, maxn) =>
    if array.size(arr) > maxn
        box.delete(array.shift(arr))
    true

// --- M15 OB ---
if showOBM15 and obBull and obTime != lastObBullT
    lastObBullT := obTime
    bx = box.new(left=obTime, top=obTop, right=obTime, bottom=obBot, xloc=xloc.bar_time, border_color=color.teal, bgcolor=colOBbull, extend=extend.right)
    array.push(obBullBoxes, bx)
    f_trimBox(obBullBoxes, obMax)

if showOBM15 and obBear and obTime != lastObBearT
    lastObBearT := obTime
    bx = box.new(left=obTime, top=obTop, right=obTime, bottom=obBot, xloc=xloc.bar_time, border_color=color.red, bgcolor=colOBbear, extend=extend.right)
    array.push(obBearBoxes, bx)
    f_trimBox(obBearBoxes, obMax)

// --- M5 OB ---
if showOBM5 and m5obBull and m5obTime != lastM5ObBullT
    lastM5ObBullT := m5obTime
    bx = box.new(left=m5obTime, top=m5obTop, right=m5obTime, bottom=m5obBot, xloc=xloc.bar_time, border_color=color.aqua, bgcolor=colOBbullM5, extend=extend.right)
    array.push(m5ObBullBoxes, bx)
    f_trimBox(m5ObBullBoxes, obMax)

if showOBM5 and m5obBear and m5obTime != lastM5ObBearT
    lastM5ObBearT := m5obTime
    bx = box.new(left=m5obTime, top=m5obTop, right=m5obTime, bottom=m5obBot, xloc=xloc.bar_time, border_color=color.fuchsia, bgcolor=colOBbearM5, extend=extend.right)
    array.push(m5ObBearBoxes, bx)
    f_trimBox(m5ObBearBoxes, obMax)

// ----------------------------------------------------------------------------
//  วาด FVG (M5)
// ----------------------------------------------------------------------------
var box[] fvgBullBoxes = array.new_box()
var box[] fvgBearBoxes = array.new_box()
var int   lastFvgBullT = na
var int   lastFvgBearT = na

if showFVG and fvgBull and fvgTime != lastFvgBullT
    lastFvgBullT := fvgTime
    bx = box.new(left=fvgTime, top=fvgBullTop, right=fvgTime, bottom=fvgBullBot, xloc=xloc.bar_time, border_color=color.new(color.green,50), bgcolor=colFVGbull, extend=extend.right)
    array.push(fvgBullBoxes, bx)
    f_trimBox(fvgBullBoxes, fvgMax)

if showFVG and fvgBear and fvgTime != lastFvgBearT
    lastFvgBearT := fvgTime
    bx = box.new(left=fvgTime, top=fvgBearTop, right=fvgTime, bottom=fvgBearBot, xloc=xloc.bar_time, border_color=color.new(color.maroon,50), bgcolor=colFVGbear, extend=extend.right)
    array.push(fvgBearBoxes, bx)
    f_trimBox(fvgBearBoxes, fvgMax)

// ----------------------------------------------------------------------------
//  VOLUME PROFILE (M15 Fixed Range) -> POC / VAH / VAL + histogram
// ----------------------------------------------------------------------------
isNewM15 = ta.change(time(tfLTF)) != 0
[m15tp, m15vol, m15hi, m15lo, m15op, m15cl] = request.security(syminfo.tickerid, tfLTF, [hl2, volume, high, low, open, close], lookahead=barmerge.lookahead_off)

var float[] vpTP  = array.new_float()
var float[] vpVol = array.new_float()
var float[] vpHi  = array.new_float()
var float[] vpLo  = array.new_float()
var float[] vpOp  = array.new_float()
var float[] vpCl  = array.new_float()

if isNewM15 and not na(m15vol)
    array.push(vpTP, m15tp)
    array.push(vpVol, m15vol)
    array.push(vpHi, m15hi)
    array.push(vpLo, m15lo)
    array.push(vpOp, m15op)
    array.push(vpCl, m15cl)
    if array.size(vpTP) > vpBars
        array.shift(vpTP)
        array.shift(vpVol)
        array.shift(vpHi)
        array.shift(vpLo)
        array.shift(vpOp)
        array.shift(vpCl)

var box[] vpBoxes = array.new_box()
var line  pocLine = na
var line  vahLine = na
var line  valLine = na
var label pocLbl  = na
var float pocPrice = na
var float vahPrice = na
var float valPrice = na

if showVPM15 and isNewM15 and array.size(vpTP) >= 10
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
        array.clear(vpBoxes)
    n = array.size(vpTP)
    pHi = array.max(vpHi)
    pLo = array.min(vpLo)
    rng = pHi - pLo
    if rng > 0
        binVol = array.new_float(vpRows, 0.0)
        for i = 0 to n - 1
            tp = array.get(vpTP, i)
            vRaw = array.get(vpVol, i)
            o15 = array.get(vpOp, i)
            c15 = array.get(vpCl, i)
            base = vpDollar ? vRaw * tp : vRaw
            v = vpMode == "DELTA" ? (c15 > o15 ? base : c15 < o15 ? -base : 0.0) : base
            idx = math.floor((tp - pLo) / rng * (vpRows - 1))
            idx := math.max(0, math.min(vpRows - 1, idx))
            array.set(binVol, idx, array.get(binVol, idx) + v)
        maxAbsV = 0.0
        pocIdx = 0
        for i = 0 to vpRows - 1
            av = math.abs(array.get(binVol, i))
            if av > maxAbsV
                maxAbsV := av
                pocIdx := i
        totalAbsV = 0.0
        for i = 0 to vpRows - 1
            totalAbsV := totalAbsV + math.abs(array.get(binVol, i))
        binH   = rng / vpRows
        pocPrice := pLo + (pocIdx + 0.5) * binH
        vaTarget = totalAbsV * vpVA / 100.0
        accV = math.abs(array.get(binVol, pocIdx))
        loI = pocIdx
        hiI = pocIdx
        while accV < vaTarget and (loI > 0 or hiI < vpRows - 1)
            volLo = loI > 0 ? math.abs(array.get(binVol, loI - 1)) : -1.0
            volHi = hiI < vpRows - 1 ? math.abs(array.get(binVol, hiI + 1)) : -1.0
            if volHi >= volLo
                hiI := hiI + 1
                accV := accV + math.max(volHi, 0)
            else
                loI := loI - 1
                accV := accV + math.max(volLo, 0)
        valPrice := pLo + loI * binH
        vahPrice := pLo + (hiI + 1) * binH
        baseX = bar_index + vpOffset
        for i = 0 to vpRows - 1
            binVal = array.get(binVol, i)
            absVal = math.abs(binVal)
            if absVal > 0
                w = math.max(1, math.round(absVal / maxAbsV * vpWidth))
                topP = pLo + (i + 1) * binH
                botP = pLo + i * binH
                col = i == pocIdx ? color.new(colPOC, 30) : (vpMode == "DELTA" ? (binVal >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)) : (i >= loI and i <= hiI ? color.new(color.blue, 70) : colVP))
                bb = box.new(left=baseX, top=topP, right=baseX + w, bottom=botP, xloc=xloc.bar_index, border_width=0, bgcolor=col)
                array.push(vpBoxes, bb)
        line.delete(pocLine)
        line.delete(vahLine)
        line.delete(valLine)
        label.delete(pocLbl)
        leftX = bar_index - n
        rightX = bar_index + vpOffset + vpWidth
        pocLine := line.new(leftX, pocPrice, rightX, pocPrice, xloc=xloc.bar_index, color=colPOC, width=2)
        vahLine := line.new(leftX, vahPrice, rightX, vahPrice, xloc=xloc.bar_index, color=colVA, width=1, style=line.style_dashed)
        valLine := line.new(leftX, valPrice, rightX, valPrice, xloc=xloc.bar_index, color=colVA, width=1, style=line.style_dashed)
        pocLbl  := label.new(rightX, pocPrice, "M15 POC " + f_fmtVol(array.get(binVol, pocIdx)), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(colPOC, 20), textcolor=color.white, size=tblSize)

// ----------------------------------------------------------------------------
//  VOLUME PROFILE (M5 Fixed Range) -> POC / VAH / VAL + histogram
//  วาดต่อจาก M15 ทางขวา เพื่อไม่ทับกัน
// ----------------------------------------------------------------------------
isNewM5vp = ta.change(time(tfM5)) != 0
[vp5tp, vp5vol, vp5hi, vp5lo, vp5op, vp5cl] = request.security(syminfo.tickerid, tfM5, [hl2, volume, high, low, open, close], lookahead=barmerge.lookahead_off)

var float[] vpTP5  = array.new_float()
var float[] vpVol5 = array.new_float()
var float[] vpHi5  = array.new_float()
var float[] vpLo5  = array.new_float()
var float[] vpOp5  = array.new_float()
var float[] vpCl5  = array.new_float()

if isNewM5vp and not na(vp5vol)
    array.push(vpTP5, vp5tp)
    array.push(vpVol5, vp5vol)
    array.push(vpHi5, vp5hi)
    array.push(vpLo5, vp5lo)
    array.push(vpOp5, vp5op)
    array.push(vpCl5, vp5cl)
    if array.size(vpTP5) > vpBars
        array.shift(vpTP5)
        array.shift(vpVol5)
        array.shift(vpHi5)
        array.shift(vpLo5)
        array.shift(vpOp5)
        array.shift(vpCl5)

var box[] vpBoxes5 = array.new_box()
var line  pocLine5 = na
var line  vahLine5 = na
var line  valLine5 = na
var label pocLbl5  = na
var float pocPrice5 = na
var float vahPrice5 = na
var float valPrice5 = na

if showVPM5 and isNewM5vp and array.size(vpTP5) >= 10
    if array.size(vpBoxes5) > 0
        for i = 0 to array.size(vpBoxes5) - 1
            box.delete(array.get(vpBoxes5, i))
        array.clear(vpBoxes5)
    n5 = array.size(vpTP5)
    pHi5 = array.max(vpHi5)
    pLo5 = array.min(vpLo5)
    rng5 = pHi5 - pLo5
    if rng5 > 0
        binVol5 = array.new_float(vpRows, 0.0)
        for i = 0 to n5 - 1
            tp5 = array.get(vpTP5, i)
            vRaw5 = array.get(vpVol5, i)
            o5 = array.get(vpOp5, i)
            c5 = array.get(vpCl5, i)
            base5 = vpDollar ? vRaw5 * tp5 : vRaw5
            v5 = vpMode == "DELTA" ? (c5 > o5 ? base5 : c5 < o5 ? -base5 : 0.0) : base5
            idx5 = math.floor((tp5 - pLo5) / rng5 * (vpRows - 1))
            idx5 := math.max(0, math.min(vpRows - 1, idx5))
            array.set(binVol5, idx5, array.get(binVol5, idx5) + v5)
        maxAbsV5 = 0.0
        pocIdx5 = 0
        for i = 0 to vpRows - 1
            av5 = math.abs(array.get(binVol5, i))
            if av5 > maxAbsV5
                maxAbsV5 := av5
                pocIdx5 := i
        totalAbsV5 = 0.0
        for i = 0 to vpRows - 1
            totalAbsV5 := totalAbsV5 + math.abs(array.get(binVol5, i))
        binH5   = rng5 / vpRows
        pocPrice5 := pLo5 + (pocIdx5 + 0.5) * binH5
        vaTarget5 = totalAbsV5 * vpVA / 100.0
        accV5 = math.abs(array.get(binVol5, pocIdx5))
        loI5 = pocIdx5
        hiI5 = pocIdx5
        while accV5 < vaTarget5 and (loI5 > 0 or hiI5 < vpRows - 1)
            volLo5 = loI5 > 0 ? math.abs(array.get(binVol5, loI5 - 1)) : -1.0
            volHi5 = hiI5 < vpRows - 1 ? math.abs(array.get(binVol5, hiI5 + 1)) : -1.0
            if volHi5 >= volLo5
                hiI5 := hiI5 + 1
                accV5 := accV5 + math.max(volHi5, 0)
            else
                loI5 := loI5 - 1
                accV5 := accV5 + math.max(volLo5, 0)
        valPrice5 := pLo5 + loI5 * binH5
        vahPrice5 := pLo5 + (hiI5 + 1) * binH5
        baseX5 = bar_index + vpOffset + vpWidth + 4
        for i = 0 to vpRows - 1
            binVal5 = array.get(binVol5, i)
            absVal5 = math.abs(binVal5)
            if absVal5 > 0
                w = math.max(1, math.round(absVal5 / maxAbsV5 * vpWidth))
                topP = pLo5 + (i + 1) * binH5
                botP = pLo5 + i * binH5
                col = i == pocIdx5 ? color.new(colPOCM5, 30) : (vpMode == "DELTA" ? (binVal5 >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)) : (i >= loI5 and i <= hiI5 ? color.new(color.fuchsia, 70) : colVPM5))
                bb = box.new(left=baseX5, top=topP, right=baseX5 + w, bottom=botP, xloc=xloc.bar_index, border_width=0, bgcolor=col)
                array.push(vpBoxes5, bb)
        line.delete(pocLine5)
        line.delete(vahLine5)
        line.delete(valLine5)
        label.delete(pocLbl5)
        leftX5 = bar_index - n5
        rightX5 = bar_index + vpOffset + 2 * vpWidth + 4
        pocLine5 := line.new(leftX5, pocPrice5, rightX5, pocPrice5, xloc=xloc.bar_index, color=colPOCM5, width=2, style=line.style_dotted)
        vahLine5 := line.new(leftX5, vahPrice5, rightX5, vahPrice5, xloc=xloc.bar_index, color=colVAM5,  width=1, style=line.style_dotted)
        valLine5 := line.new(leftX5, valPrice5, rightX5, valPrice5, xloc=xloc.bar_index, color=colVAM5,  width=1, style=line.style_dotted)
        pocLbl5  := label.new(rightX5, pocPrice5, "M5 POC " + f_fmtVol(array.get(binVol5, pocIdx5)), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(colPOCM5, 20), textcolor=color.white, size=tblSize)

// ----------------------------------------------------------------------------
//  TP / SL อัตโนมัติ (คำนวณหลัง VP เพื่อใช้ค่า POC/VA ได้)
// ----------------------------------------------------------------------------
var int   tradeDir = 0
var float ePrice = na
var float slP = na
var float tp1P = na
var float tp2P = na
var float rrShown = na
var line  lnE = na
var line  lnSL = na
var line  lnT1 = na
var line  lnT2 = na
var label lbSL = na
var label lbT1 = na
var label lbT2 = na

atrv = ta.atr(atrLen)
swLo = ta.lowest(low, slLB)
swHi = ta.highest(high, slLB)

if (buyEntry or sellEntry)
    isLong = buyEntry
    tradeDir := isLong ? 1 : -1
    ePrice := close
    // ----- SL -----
    if isLong
        slP := slMode == "ATR" ? ePrice - atrv * slAtr : math.min(swLo, ePrice) - atrv * slBuf
    else
        slP := slMode == "ATR" ? ePrice + atrv * slAtr : math.max(swHi, ePrice) + atrv * slBuf
    risk = math.abs(ePrice - slP)
    // ----- TP -----
    if tpMode == "RR"
        tp1P := isLong ? ePrice + risk * rr1 : ePrice - risk * rr1
        tp2P := isLong ? ePrice + risk * rr2 : ePrice - risk * rr2
    else
        if isLong
            tp1P := (not na(pocPrice) and pocPrice > ePrice) ? pocPrice : (not na(vahPrice) and vahPrice > ePrice ? vahPrice : ePrice + risk * rr1)
            tp2P := (not na(vahPrice) and vahPrice > tp1P)   ? vahPrice : ePrice + risk * rr2
        else
            tp1P := (not na(pocPrice) and pocPrice < ePrice) ? pocPrice : (not na(valPrice) and valPrice < ePrice ? valPrice : ePrice - risk * rr1)
            tp2P := (not na(valPrice) and valPrice < tp1P)   ? valPrice : ePrice - risk * rr2
    rrShown := risk > 0 ? math.abs(tp1P - ePrice) / risk : na
    // ----- วาดเส้น (เก็บชุดล่าสุดชุดเดียว) -----
    if showTPSL
        line.delete(lnE)
        line.delete(lnSL)
        line.delete(lnT1)
        line.delete(lnT2)
        label.delete(lbSL)
        label.delete(lbT1)
        label.delete(lbT2)
        lnE  := line.new(bar_index, ePrice, bar_index + 30, ePrice, color=color.gray,  width=1, style=line.style_dotted, extend=extend.right)
        lnSL := line.new(bar_index, slP,    bar_index + 30, slP,    color=color.red,   width=2, extend=extend.right)
        lnT1 := line.new(bar_index, tp1P,   bar_index + 30, tp1P,   color=color.green, width=1, extend=extend.right)
        lnT2 := line.new(bar_index, tp2P,   bar_index + 30, tp2P,   color=color.green, width=2, extend=extend.right)
        lbSL := label.new(bar_index + 30, slP,  "SL "+str.tostring(slP, format.mintick),  style=label.style_label_left, color=color.new(color.red,20),   textcolor=color.white, size=size.small)
        lbT1 := label.new(bar_index + 30, tp1P, "TP1 "+str.tostring(tp1P, format.mintick), style=label.style_label_left, color=color.new(color.green,20), textcolor=color.white, size=size.small)
        lbT2 := label.new(bar_index + 30, tp2P, "TP2 "+str.tostring(tp2P, format.mintick), style=label.style_label_left, color=color.new(color.green,0),  textcolor=color.white, size=size.small)

// ----------------------------------------------------------------------------
//  พื้นหลังตาม Bias
// ----------------------------------------------------------------------------
bgcolor(htfBias == 1 and ltfBias == 1 ? color.new(color.green, 92) : htfBias == -1 and ltfBias == -1 ? color.new(color.red, 92) : na, title="Bias Background")

// ----------------------------------------------------------------------------
//  ตาราง
// ----------------------------------------------------------------------------
f_biasTxt(b) => b == 1 ? "▲ ขึ้น" : b == -1 ? "▼ ลง" : "■ Side"
f_biasCol(b) => b == 1 ? color.new(color.green, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
f_stateTxt(bull) => bull ? "Long" : "Short"
f_stateCol(bull) => bull ? color.new(color.green, 0) : color.new(color.red, 0)

txtCol = color.white
hdrCol = color.new(#1E2761, 0)
cellBg = color.new(#0d1b2a, 20)

// ===== ตาราง Bias (ซ้ายบน) =====
var table tBias = table.new(position.top_left, 2, 3, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(tBias, 0, 0, "BIAS", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tBias, 1, 0, "ทิศทาง", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tBias, 0, 1, "HTF (M30)", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBias, 1, 1, f_biasTxt(htfBias), text_color=color.white, bgcolor=f_biasCol(htfBias), text_size=tblSize)
    table.cell(tBias, 0, 2, "LTF (M15)", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBias, 1, 2, f_biasTxt(ltfBias), text_color=color.white, bgcolor=f_biasCol(ltfBias), text_size=tblSize)

// ===== ตาราง Signal M1/M3/M5 รวม (ขวาบน) — รวมเป็นตารางเดียวเพื่อให้พอดีจอมือถือ =====
var table tSig = table.new(position.top_right, 4, 6, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(tSig, 0, 0, "SIGNAL", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tSig, 1, 0, "M1", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tSig, 2, 0, "M3", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tSig, 3, 0, "M5", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tSig, 0, 1, "สถานะ", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 1, 1, f_stateTxt(m1bull), text_color=color.white, bgcolor=f_stateCol(m1bull), text_size=tblSize)
    table.cell(tSig, 2, 1, f_stateTxt(m3bull), text_color=color.white, bgcolor=f_stateCol(m3bull), text_size=tblSize)
    table.cell(tSig, 3, 1, f_stateTxt(m5bull), text_color=color.white, bgcolor=f_stateCol(m5bull), text_size=tblSize)
    table.cell(tSig, 0, 2, "เข้า Buy", text_color=txtCol, bgcolor=color.new(color.green,60), text_size=tblSize)
    table.cell(tSig, 1, 2, f_px(m1_be), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 2, 2, f_px(m3_be), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 3, 2, f_px(m5_be), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 0, 3, "ออก Buy", text_color=txtCol, bgcolor=color.new(color.orange,60), text_size=tblSize)
    table.cell(tSig, 1, 3, f_px(m1_bx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 2, 3, f_px(m3_bx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 3, 3, f_px(m5_bx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 0, 4, "เข้า Sell", text_color=txtCol, bgcolor=color.new(color.red,60), text_size=tblSize)
    table.cell(tSig, 1, 4, f_px(m1_se), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 2, 4, f_px(m3_se), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 3, 4, f_px(m5_se), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 0, 5, "ออก Sell", text_color=txtCol, bgcolor=color.new(color.lime,60), text_size=tblSize)
    table.cell(tSig, 1, 5, f_px(m1_sx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 2, 5, f_px(m3_sx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tSig, 3, 5, f_px(m5_sx), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)

// ===== ตาราง TP/SL + Breakout (ขวาล่าง) =====
boTxt = boBull ? "▲ ทะลุ High" : boBear ? "▼ หลุด Low" : "■ ในกรอบ"
boCol = boBull ? color.new(color.green,0) : boBear ? color.new(color.red,0) : color.new(color.gray,0)
dirTxt = tradeDir == 1 ? "LONG" : tradeDir == -1 ? "SHORT" : "-"
dirCol = tradeDir == 1 ? color.new(color.green,0) : tradeDir == -1 ? color.new(color.red,0) : color.new(color.gray,0)
var table tBO = table.new(position.bottom_right, 2, 8, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(tBO, 0, 0, "TRADE / BO M15", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tBO, 1, 0, "ค่า", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tBO, 0, 1, "ทิศทางล่าสุด", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 1, 1, dirTxt, text_color=color.white, bgcolor=dirCol, text_size=tblSize)
    table.cell(tBO, 0, 2, "Entry", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 1, 2, f_px(ePrice), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 0, 3, "SL", text_color=txtCol, bgcolor=color.new(color.red,50), text_size=tblSize)
    table.cell(tBO, 1, 3, f_px(slP), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 0, 4, "TP1", text_color=txtCol, bgcolor=color.new(color.green,50), text_size=tblSize)
    table.cell(tBO, 1, 4, f_px(tp1P), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 0, 5, "TP2", text_color=txtCol, bgcolor=color.new(color.green,30), text_size=tblSize)
    table.cell(tBO, 1, 5, f_px(tp2P), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 0, 6, "R:R (TP1)", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 1, 6, na(rrShown)?"-":str.tostring(rrShown,"#.#"), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 0, 7, "Breakout M15", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tBO, 1, 7, boTxt, text_color=color.white, bgcolor=boCol, text_size=tblSize)

// ===== ตาราง Volume Buy/Sell (ซ้ายล่าง) =====
m5tot  = m5uv + m5dv
m15tot = m15uv + m15dv
m5buyPct  = m5tot  > 0 ? m5uv  / m5tot  * 100 : 0
m15buyPct = m15tot > 0 ? m15uv / m15tot * 100 : 0
f_volCol(pct) => pct >= 55 ? color.new(color.green,0) : pct <= 45 ? color.new(color.red,0) : color.new(color.gray,0)

var table tVol = table.new(position.bottom_left, 3, 5, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(tVol, 0, 0, "VOLUME", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tVol, 1, 0, "M5",  text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tVol, 2, 0, "M15", text_color=txtCol, bgcolor=hdrCol, text_size=tblSize)
    table.cell(tVol, 0, 1, "Buy Vol", text_color=txtCol, bgcolor=color.new(color.green,60), text_size=tblSize)
    table.cell(tVol, 1, 1, str.tostring(m5uv,  format.volume), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 2, 1, str.tostring(m15uv, format.volume), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 0, 2, "Sell Vol", text_color=txtCol, bgcolor=color.new(color.red,60), text_size=tblSize)
    table.cell(tVol, 1, 2, str.tostring(m5dv,  format.volume), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 2, 2, str.tostring(m15dv, format.volume), text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 0, 3, "Buy %", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 1, 3, str.tostring(m5buyPct,  "#.#")+"%", text_color=color.white, bgcolor=f_volCol(m5buyPct),  text_size=tblSize)
    table.cell(tVol, 2, 3, str.tostring(m15buyPct, "#.#")+"%", text_color=color.white, bgcolor=f_volCol(m15buyPct), text_size=tblSize)
    table.cell(tVol, 0, 4, "ฝั่งเด่น", text_color=txtCol, bgcolor=cellBg, text_size=tblSize)
    table.cell(tVol, 1, 4, m5buyPct>=50?"BUY":"SELL",  text_color=color.white, bgcolor=f_volCol(m5buyPct),  text_size=tblSize)
    table.cell(tVol, 2, 4, m15buyPct>=50?"BUY":"SELL", text_color=color.white, bgcolor=f_volCol(m15buyPct), text_size=tblSize)

// ----------------------------------------------------------------------------
//  ALERTS
// ----------------------------------------------------------------------------
alertcondition(buyEntry,  "Buy Entry",  "เข้า Buy (ตามโหมดที่ตั้ง)")
alertcondition(sellEntry, "Sell Entry", "เข้า Sell (ตามโหมดที่ตั้ง)")
